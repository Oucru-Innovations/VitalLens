# =============================================================
# VitalLens runtime config
#
# EASIEST SETUP: don't edit this file at all. Run VitalLens.exe
# and click "⚙ Cấu hình kết nối" at the bottom of the home page.
# It writes %APPDATA%\VitalLens\.env, which survives replacing the
# onefile EXE with a newer release.
#
# MANUAL SETUP (still supported): copy this file to `.env` in the
# same folder as VitalLens.exe / main.py and fill in the values.
# Loaded after %APPDATA%, so the dialog's values win.
#
# This is a tracked template for source/dev and the PyInstaller debug bundle.
# The official Nuitka onefile release ships no separate config file.
# NEVER commit or distribute a filled-in `.env` — it holds a
# live credential. Tokens are issued per user, not shared.
# =============================================================

# --- API upload (required to push PDF+CSV to backend) ---
# Must be https:// — the bearer token is sent with this request,
# and plain http:// puts it on the wire in cleartext.
API_UPLOAD_URL=https://your-api.example.org/api/v2/file/upload
API_BEARER_TOKEN=replace_me_with_your_own_token

# Pre-fills the "owner email" prompt shown before an upload.
API_UPLOAD_OWNER=you@example.org

# --- SFTP (defaults are in apps/config.py, override here if needed) ---
# SFTP_HOST=datastore.oucru.org
# SFTP_PORT=22
# SFTP_DEMO_MODE=false
# SFTP_PATH=/EI_SHARE/.received/13NV/PROCESSING

# --- Update check (optional) ---
# URL of a small PUBLIC json: {"version": "0.4.0", "url": "https://..."}
# The app only READS it and shows "a new version is available" on the home
# page — it never downloads or installs anything by itself. Leave unset to
# disable the check entirely (no outbound request at all).
# UPDATE_MANIFEST_URL=https://your-host.example.org/vitallens/latest.json

# --- Troubleshooting only ---
# Set to 1 to write config_debug.log next to the app (secrets are
# redacted to a length). Leave unset in normal use, and delete the
# log when you are done.
# VITALLENS_DEBUG_CONFIG=1
# --- SFTP buffer dir (destination for X-Ray / XML "Upload lên SFTP" buttons;
#     a separate inference util picks up files from here) ---
# SFTP_BUFFER_PATH=/EI_SHARE/.buffer
# SFTP_UPLOAD_DEFAULT_USER=default@gmail.com
