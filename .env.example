# =============================================================
# VitalLens runtime config
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` (contains secrets).
# =============================================================

# --- API upload (required to push PDF+CSV to backend) ---
API_UPLOAD_URL=https://your-api.example.org/upload
API_BEARER_TOKEN=replace_me_with_real_token

# --- SFTP (defaults are in apps/config.py, override here if needed) ---
# SFTP_HOST=datastore.oucru.org
# SFTP_PORT=22
# SFTP_DEMO_MODE=false
# SFTP_PATH=/EI_SHARE/.received/13NV/PROCESSING
